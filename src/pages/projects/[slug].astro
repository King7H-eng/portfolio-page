---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getCollection, render } from 'astro:content';
import { PROJECT_ORDER } from '../../lib/projects';

export async function getStaticPaths() {
  const all = await getCollection('projects');
  const ordered = PROJECT_ORDER
    .map((slug) => all.find((p) => p.data.slug === slug))
    .filter((p): p is NonNullable<typeof p> => Boolean(p));

  return ordered.map((project, i) => ({
    params: { slug: project.data.slug },
    props: {
      project,
      prev: i > 0 ? ordered[i - 1] : null,
      next: i < ordered.length - 1 ? ordered[i + 1] : null,
      position: i + 1,
      total: ordered.length,
    },
  }));
}

const { project, prev, next, position, total } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);

const base = import.meta.env.BASE_URL;
const catKey = data.category.toLowerCase().replace(/[^a-z]/g, '');
const toc = headings.filter((h) => h.depth === 2);

const isSet = (v?: string) => Boolean(v && v !== 'TODO');

function formatDate(d?: string) {
  if (!isSet(d)) return null;
  const parts = d!.split('-');
  if (parts.length === 3) {
    return new Date(`${d}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
  }
  if (parts.length === 2) {
    const date = new Date(`${d}-01`);
    return date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
  }
  return d;
}
const dateDisplay = formatDate(data.date);

// If the cover is one of the report figures, show it once, in full, as the lead figure.
// Otherwise the cover is a photo: show it as a cropped banner and keep all figures for the body.
const coverIsFigure = data.figures.some((f) => f.src === data.cover);
const [leadFigure, ...moreFigures] = coverIsFigure ? data.figures : [null, ...data.figures];
const coverPhoto = !coverIsFigure && data.cover ? data.cover : null;
const figOffset = leadFigure ? 2 : 1;

const facts = [
  { label: 'Type', value: data.type },
  { label: 'Institution', value: isSet(data.institution) ? data.institution : null },
  { label: 'Date', value: dateDisplay },
  { label: 'Team', value: data.team && data.team.length > 0 ? `${data.team.length} people` : 'Individual' },
].filter((f) => f.value);

const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  title={`${data.title} — Nicholas Mommsen`}
  description={data.summary}
  ogImage={data.ogImage || data.cover || undefined}
  ogType="article"
>
  <SiteHeader />

  <main id="main-content" class="project-page">

    <!-- Breadcrumb -->
    <nav class="back-bar" aria-label="Breadcrumb">
      <div class="wrap back-inner">
        <a href={`${base}#projects`} class="back-link">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M9 2L4 7L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          All projects
        </a>
        <span class="crumb-index mono" aria-label={`Project ${position} of ${total}`}>
          {pad(position)} / {pad(total)}
        </span>
      </div>
    </nav>

    <!-- Header -->
    <header class="project-header">
      <div class="wrap">
        <div class="project-meta">
          {[data.category, ...data.extraCategories].map((c) => (
            <span class={`cat-badge mono cat-${c.toLowerCase().replace(/[^a-z]/g, '')}`}>{c}</span>
          ))}
          <span class="meta-type">{data.type}</span>
          {dateDisplay && (
            <>
              <span class="meta-dot" aria-hidden="true">·</span>
              <time class="meta-date mono">{dateDisplay}</time>
            </>
          )}
        </div>

        <h1 class="project-title">{data.title}</h1>
        {data.subtitle && <p class="project-subtitle">{data.subtitle}</p>}
        {!data.showSummary ? null : data.abstract ? (
          <div class="project-abstract">
            <p class="abstract-label mono">Abstract</p>
            <p class="project-summary">{data.abstract}</p>
          </div>
        ) : (
          <p class="project-summary">{data.summary}</p>
        )}
      </div>
    </header>

    <!-- Metrics band -->
    {data.showMetrics && data.metrics.length > 0 && (
      <section class="metrics-band" aria-label="Key metrics">
        <dl class="wrap metrics-inner">
          {data.metrics.map((m) => (
            <div class="metric-item">
              <dt class="metric-label">{m.label}</dt>
              <dd class="metric-value mono" data-target={m.value}>{m.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <!-- Cover photo banner -->
    {coverPhoto && (
      <div class:list={["wrap cover-photo-wrap", { "no-band": !(data.showMetrics && data.metrics.length > 0) }]}>
        <div class="cover-photo">
          <img src={coverPhoto} alt={data.coverAlt ?? ''} style={data.coverPosition ? `object-position:${data.coverPosition}` : undefined} loading="eager" decoding="async" fetchpriority="high" />
        </div>
      </div>
    )}

    <!-- Lead figure: shown whole, never cropped -->
    {leadFigure && (
      <section class="wrap lead-figure-wrap" aria-label="Lead figure">
        <figure class="lead-figure">
          <button class="fig-open" type="button" data-src={leadFigure.src} data-caption={leadFigure.caption} aria-label="Enlarge figure 1">
            <img src={leadFigure.src} alt={leadFigure.caption || data.title} loading="eager" decoding="async" />
          </button>
          {leadFigure.caption && (
            <figcaption class="fig-caption">
              <span class="fig-num mono">Fig. 1</span>
              {leadFigure.caption}
            </figcaption>
          )}
        </figure>
      </section>
    )}

    <!-- Body: write-up + sticky sidebar -->
    <div class="wrap project-body">

      <aside class="sidebar" aria-label="Project details">
        <div class="sidebar-inner">

          {data.showFacts && (
          <section class="side-block">
            <h2 class="side-heading mono">At a glance</h2>
            <dl class="facts">
              {facts.map((f) => (
                <div class="fact">
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))}
            </dl>
          </section>
          )}

          {data.tags.length > 0 && (
            <section class="side-block">
              <h2 class="side-heading mono">Tools &amp; methods</h2>
              <ul class="chips" role="list">
                {data.tags.map((t) => <li class="chip mono">{t}</li>)}
              </ul>
            </section>
          )}

          {toc.length > 1 && (
            <nav class="side-block toc" aria-label="On this page">
              <h2 class="side-heading mono">On this page</h2>
              <ol role="list">
                {toc.map((h) => (
                  <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>
                ))}
              </ol>
            </nav>
          )}

          {data.visibility === 'Summary only' && (
            <p class="side-note">
              Summary of the full report. The original document is available on request.
            </p>
          )}
        </div>
      </aside>

      <article class="prose project-prose">
        <Content />

        {moreFigures.length > 0 && (
          <section class="figures-section" aria-labelledby="figures-heading">
            <h2 id="figures-heading">{data.figuresTitle}</h2>
            <div class="figures-grid">
              {moreFigures.map((fig, i) => (
                <figure class="fig-item">
                  <button class="fig-open" type="button" data-src={fig.src} data-caption={fig.caption} aria-label={`Enlarge figure ${i + figOffset}`}>
                    <img src={fig.src} alt={fig.caption} loading="lazy" decoding="async" />
                  </button>
                  <figcaption class="fig-caption">
                    <span class="fig-num mono">Fig. {i + figOffset}</span>
                    {fig.caption}
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )}
      </article>
    </div>

    <!-- Prev / next -->
    <nav class="pager" aria-label="More projects">
      <div class="wrap pager-inner">
        {prev ? (
          <a class="pager-link pager-prev" href={`${base}projects/${prev.data.slug}/`}>
            <span class="pager-dir mono">← Previous</span>
            <span class="pager-title">{prev.data.title}</span>
          </a>
        ) : <span />}
        {next ? (
          <a class="pager-link pager-next" href={`${base}projects/${next.data.slug}/`}>
            <span class="pager-dir mono">Next →</span>
            <span class="pager-title">{next.data.title}</span>
          </a>
        ) : (
          <a class="pager-link pager-next" href={`${base}#projects`}>
            <span class="pager-dir mono">Back to →</span>
            <span class="pager-title">All projects</span>
          </a>
        )}
      </div>
    </nav>

    <!-- Lightbox -->
    <dialog class="lightbox" aria-label="Enlarged figure">
      <form method="dialog" class="lb-close-form">
        <button class="lb-close mono" aria-label="Close">Esc ✕</button>
      </form>
      <img class="lb-img" alt="" />
      <p class="lb-caption"></p>
    </dialog>

  </main>
</BaseLayout>

<script>
  /* Count-up on headline metrics (keeps the number's own decimal places) */
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function animateCount(el: HTMLElement) {
    const raw = el.dataset.target ?? '';
    const match = raw.match(/\d+(?:\.\d+)?/);
    if (!match) return;
    const target = parseFloat(match[0]);
    const decimals = (match[0].split('.')[1] ?? '').length;
    const start = performance.now();
    const duration = 1100;
    function step(now: number) {
      const t = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = raw.replace(match![0], (target * eased).toFixed(decimals));
      if (t < 1) requestAnimationFrame(step);
      else el.textContent = raw;
    }
    requestAnimationFrame(step);
  }
  if (!reduce) {
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (e.isIntersecting) { animateCount(e.target as HTMLElement); io.unobserve(e.target); }
    }), { threshold: 0.4 });
    document.querySelectorAll<HTMLElement>('.metric-value[data-target]').forEach((el) => io.observe(el));
  }

  /* Table of contents: highlight the section being read */
  const tocLinks = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-toc]').forEach((a) => tocLinks.set(a.dataset.toc!, a));
  if (tocLinks.size) {
    const spy = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        tocLinks.forEach((a) => a.removeAttribute('aria-current'));
        tocLinks.get(e.target.id)?.setAttribute('aria-current', 'true');
      });
    }, { rootMargin: '-15% 0px -75% 0px' });
    tocLinks.forEach((_, id) => { const h = document.getElementById(id); if (h) spy.observe(h); });
  }

  /* Lightbox for figures */
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const lbImg = dialog?.querySelector<HTMLImageElement>('.lb-img');
  const lbCap = dialog?.querySelector<HTMLElement>('.lb-caption');
  document.querySelectorAll<HTMLButtonElement>('.fig-open').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!dialog || !lbImg || !lbCap) return;
      lbImg.src = btn.dataset.src ?? '';
      lbImg.alt = btn.dataset.caption ?? '';
      lbCap.textContent = btn.dataset.caption ?? '';
      dialog.showModal();
    });
  });
  dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
</script>

<style>
  .project-page { min-height: 100dvh; }

  .wrap {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* ── Breadcrumb ── */
  .back-bar { border-bottom: 1px solid var(--border); padding: var(--space-3) 0; }
  .back-inner { display: flex; justify-content: space-between; align-items: center; }
  .back-link {
    display: inline-flex; align-items: center; gap: var(--space-2);
    font-size: var(--text-sm); color: var(--text-muted);
    transition: color var(--transition-fast);
  }
  .back-link:hover { color: var(--text); }
  .crumb-index { font-size: 0.72rem; color: var(--text-faint); letter-spacing: 0.08em; }

  /* ── Header ── */
  .project-header { padding: var(--space-16) 0 var(--space-12); }
  .project-meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3);
    font-size: var(--text-xs); margin-bottom: var(--space-6);
  }
  .cat-badge {
    font-size: 0.68rem; font-weight: 500; letter-spacing: 0.07em; text-transform: uppercase;
    padding: 2px 8px; border-radius: var(--radius-sm); border: 1px solid currentColor;
  }
  .cat-engineering { color: var(--cat-engineering); border-color: rgba(127,176,255,0.3); }
  .cat-data        { color: var(--cat-data);        border-color: rgba(196,168,255,0.3); }
  .cat-finance     { color: var(--cat-finance);     border-color: rgba(94,230,176,0.3); }
  .cat-energy      { color: var(--cat-energy);      border-color: rgba(245,181,68,0.3); }
  .meta-dot  { color: var(--text-faint); }
  .meta-type { color: var(--text-muted); }
  .meta-date { color: var(--text-muted); font-size: 0.72rem; }

  .project-title {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 800; letter-spacing: -0.035em; line-height: 1.08;
    color: var(--text); max-width: 22ch; margin-bottom: var(--space-6);
    text-wrap: balance;
  }
  .project-abstract { border-left: 2px solid var(--accent); padding-left: var(--space-5, 1.25rem); max-width: 66ch; }
  .abstract-label {
    font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--accent); margin: 0 0 var(--space-2);
  }
  .project-subtitle {
    font-size: var(--text-lg); color: var(--text-muted); font-style: italic;
    max-width: 60ch; line-height: 1.5; margin: calc(-1 * var(--space-2)) 0 var(--space-6); text-wrap: balance;
  }
  .project-summary {
    font-size: var(--text-lg); color: var(--text-muted);
    max-width: 62ch; line-height: 1.7; text-wrap: pretty;
  }

  /* ── Metrics ── */
  .metrics-band {
    border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
    background: var(--surface); backdrop-filter: blur(4px);
  }
  .metrics-inner {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    margin-top: 0; margin-bottom: 0;
  }
  .metric-item {
    display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: var(--space-2);
    padding: var(--space-8) var(--space-6) var(--space-8) 0;
  }
  .metric-item + .metric-item { border-left: 1px solid var(--border); padding-left: var(--space-6); }
  .metric-value {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 700; color: var(--text);
    letter-spacing: -0.04em; line-height: 1; font-variant-numeric: tabular-nums;
  }
  .metric-label { font-size: 0.75rem; color: var(--text-muted); line-height: 1.45; max-width: 18rem; }

  /* ── Figures (shared) ── */
  .fig-open {
    display: block; width: 100%; padding: 0; border: 0; cursor: zoom-in;
    background: #fff; /* report figures are on white: frame them cleanly */
  }
  .fig-open img { display: block; width: 100%; height: auto; }
  .fig-open:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .fig-caption {
    padding: var(--space-3) var(--space-4); font-size: var(--text-xs);
    color: var(--text-muted); line-height: 1.6; border-top: 1px solid var(--border);
  }
  .fig-num { color: var(--accent); margin-right: var(--space-2); }

  .lead-figure-wrap { padding-top: var(--space-12); }

  .cover-photo-wrap { padding-top: var(--space-12); }
  .cover-photo-wrap.no-band { padding-top: 0; }
  .cover-photo {
    border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden;
    aspect-ratio: 21 / 8; background: var(--surface);
  }
  .cover-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 40%; display: block; }
  @media (max-width: 640px) { .cover-photo { aspect-ratio: 4 / 3; } }
  .lead-figure {
    margin: 0 auto; max-width: 820px;
    border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden;
    background: var(--surface);
  }
  .lead-figure .fig-open img { max-height: 520px; object-fit: contain; }

  /* ── Body layout ── */
  .project-body {
    display: grid; grid-template-columns: minmax(0, 1fr) 248px;
    gap: var(--space-16); padding-top: var(--space-12); padding-bottom: var(--space-24);
    align-items: start;
  }
  .project-prose { grid-column: 1; grid-row: 1; max-width: 70ch; min-width: 0; }
  .project-prose > :global(h2:first-child) { margin-top: 0; }
  .project-prose :global(h2) { scroll-margin-top: 96px; }

  /* ── Sidebar ── */
  .sidebar { grid-column: 2; grid-row: 1; position: sticky; top: 88px; }
  .sidebar-inner { display: flex; flex-direction: column; gap: var(--space-8); }
  .side-heading {
    font-size: 0.68rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--accent); margin-bottom: var(--space-3);
  }
  .facts { display: flex; flex-direction: column; margin: 0; }
  .fact {
    display: flex; justify-content: space-between; gap: var(--space-4);
    padding: var(--space-2) 0; border-bottom: 1px solid var(--border); font-size: var(--text-sm);
  }
  .fact dt { color: var(--text-faint); }
  .fact dd { margin: 0; color: var(--text); text-align: right; }

  .chips { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; margin: 0; }
  .chip {
    font-size: 0.7rem; color: var(--text-muted);
    border: 1px solid var(--border-strong); border-radius: 999px; padding: 3px 10px;
  }

  .toc ol { list-style: none; padding: 0; margin: 0; border-left: 1px solid var(--border); }
  .toc a {
    display: block; padding: 5px 0 5px var(--space-4); margin-left: -1px;
    border-left: 1px solid transparent;
    font-size: var(--text-sm); color: var(--text-faint);
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }
  .toc a:hover { color: var(--text); }
  .toc a[aria-current='true'] { color: var(--text); border-left-color: var(--accent); }

  .side-note { font-size: var(--text-xs); color: var(--text-faint); line-height: 1.6; margin: 0; }

  /* ── Figure grid ── */
  .figures-section { margin-top: var(--space-12); }
  .figures-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4); }
  .fig-item {
    margin: 0; background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-md); overflow: hidden; display: flex; flex-direction: column;
    transition: border-color var(--transition-mid);
  }
  .fig-item:hover { border-color: rgba(76, 141, 255, 0.45); }
  .fig-item .fig-open { aspect-ratio: 4 / 3; overflow: hidden; }
  .fig-item .fig-open img { height: 100%; object-fit: contain; }

  /* ── Prev / next ── */
  .pager { border-top: 1px solid var(--border); }
  .pager-inner { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); padding-top: var(--space-8); padding-bottom: var(--space-16); }
  .pager-link {
    display: flex; flex-direction: column; gap: var(--space-2);
    padding: var(--space-6); border: 1px solid var(--border); border-radius: var(--radius-lg);
    background: var(--surface);
    transition: border-color var(--transition-mid), transform var(--transition-mid);
  }
  .pager-link:hover { border-color: rgba(76, 141, 255, 0.45); transform: translateY(-2px); }
  .pager-next { text-align: right; }
  .pager-dir { font-size: 0.7rem; letter-spacing: 0.08em; color: var(--accent); text-transform: uppercase; }
  .pager-title { font-size: var(--text-base); font-weight: 600; color: var(--text); line-height: 1.35; }

  /* ── Lightbox ── */
  .lightbox {
    margin: auto; max-width: min(1200px, 94vw); max-height: 92vh; padding: var(--space-4);
    border: 1px solid var(--border-strong); border-radius: var(--radius-lg);
    background: #0b0b0d; color: var(--text);
  }
  .lightbox::backdrop { background: rgba(0, 0, 0, 0.8); backdrop-filter: blur(4px); }
  .lb-close-form { display: flex; justify-content: flex-end; margin-bottom: var(--space-2); }
  .lb-close {
    background: none; border: 1px solid var(--border-strong); border-radius: var(--radius-sm);
    color: var(--text-muted); font-size: 0.7rem; padding: 4px 8px; cursor: pointer;
  }
  .lb-img { display: block; max-width: 100%; max-height: 76vh; margin: 0 auto; background: #fff; }
  .lb-caption { font-size: var(--text-sm); color: var(--text-muted); margin: var(--space-3) 0 0; max-width: 80ch; }

  /* ── Responsive ── */
  @media (max-width: 960px) {
    .project-body { grid-template-columns: 1fr; gap: 2.5rem; }
    .sidebar { position: static; grid-column: 1; grid-row: 1; }
    .project-prose { grid-row: 2; }
    .toc { display: none; }
    .sidebar-inner { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); }
    .side-note { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .project-header { padding: var(--space-12) 0 var(--space-8); }
    .project-summary { font-size: var(--text-base); }
    .metrics-inner { grid-template-columns: 1fr; }
    .metric-item, .metric-item + .metric-item { border-left: 0; padding: var(--space-4) 0; }
    .metric-item + .metric-item { border-top: 1px solid var(--border); }
    .sidebar-inner { grid-template-columns: 1fr; }
    .figures-grid { grid-template-columns: 1fr; }
    .pager-inner { grid-template-columns: 1fr; }
    .pager-next { text-align: left; }
  }
</style>

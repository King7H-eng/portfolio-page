---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const base = import.meta.env.BASE_URL;
const backHref = base;

const catKey = data.category.toLowerCase().replace(/[^a-z]/g, '');

function formatDate(d?: string) {
  if (!d || d === 'TODO') return null;
  const parts = d.split('-');
  if (parts.length === 2) {
    const date = new Date(`${d}-01`);
    return date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
  }
  return d;
}
const dateDisplay = formatDate(data.date);
---

<BaseLayout
  title={`${data.title} — Nicholas Mommsen`}
  description={data.summary}
  ogImage={data.cover || undefined}
  ogType="article"
>
  <SiteHeader />

  <main id="main-content" class="project-page">

    <!-- Back nav -->
    <nav class="back-bar" aria-label="Breadcrumb">
      <div class="back-inner">
        <a href={backHref} class="back-link">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M9 2L4 7L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          All projects
        </a>
      </div>
    </nav>

    <!-- Project header -->
    <header class="project-header">
      <div class="header-inner">

        <div class="project-meta" aria-label="Project metadata">
          <span class={`cat-badge mono cat-${catKey}`}>{data.category}</span>
          <span class="meta-dot" aria-hidden="true">·</span>
          <span class="meta-type">{data.type}</span>
          {data.institution && data.institution !== 'TODO' && (
            <>
              <span class="meta-dot" aria-hidden="true">·</span>
              <span class="meta-inst">{data.institution}</span>
            </>
          )}
          {dateDisplay && (
            <>
              <span class="meta-dot" aria-hidden="true">·</span>
              <time class="meta-date mono">{dateDisplay}</time>
            </>
          )}
        </div>

        <h1 class="project-title">{data.title}</h1>

        <p class="project-summary">{data.summary}</p>

        {data.team && data.team.length > 0 && (
          <div class="project-team">
            <span class="team-label mono">Team</span>
            <span class="team-names">{data.team.join(' · ')}</span>
          </div>
        )}
      </div>
    </header>

    <!-- Metrics band -->
    {data.metrics.length > 0 && (
      <section class="metrics-band" aria-label="Key metrics">
        <div class="metrics-inner">
          {data.metrics.map((m, i) => (
            <div class="metric-item">
              <span
                class="metric-value mono"
                data-target={m.value}
                aria-label={`${m.value}: ${m.label}`}
              >
                {m.value}
              </span>
              <span class="metric-label">{m.label}</span>
              {i < data.metrics.length - 1 && (
                <div class="metric-divider" aria-hidden="true"></div>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Cover image -->
    {data.cover && (
      <div class="project-cover">
        <img src={data.cover} alt="" loading="eager" decoding="async" />
        <div class="cover-fade" aria-hidden="true"></div>
      </div>
    )}

    <!-- Body -->
    <div class="project-body">
      <div class="project-body-inner">

        <div class="prose project-prose">
          <Content />
        </div>

        {data.figures && data.figures.length > 0 && (
          <section class="figures-section" aria-labelledby="figures-heading">
            <h2 id="figures-heading" class="figures-heading">Figures</h2>
            <div class="figures-grid">
              {data.figures.map((fig, i) => (
                <figure class="fig-item">
                  <div class="fig-img-wrap">
                    <img
                      src={fig.src}
                      alt={fig.caption}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <figcaption class="fig-caption">
                    <span class="fig-num mono">Fig. {i + 1}</span>
                    {fig.caption}
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )}

      </div>
    </div>

  </main>
</BaseLayout>

<!-- Count-up on metrics -->
<script>
  function animateCount(el: HTMLElement) {
    const raw = el.dataset.target ?? '';
    const match = raw.match(/[\d.]+/);
    if (!match) return;
    const target = parseFloat(match[0]);
    const isFloat = raw.includes('.');
    const duration = 1200;
    const start = performance.now();

    function step(now: number) {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = target * eased;
      const displayed = isFloat ? current.toFixed(1) : Math.round(current).toString();
      el.textContent = raw.replace(match[0], displayed);
      if (progress < 1) requestAnimationFrame(step);
      else el.textContent = raw;
    }
    requestAnimationFrame(step);
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animateCount(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.4 }
  );

  document.querySelectorAll<HTMLElement>('.metric-value[data-target]')
    .forEach((el) => observer.observe(el));
</script>

<style>
  /* ── Page shell ──────────────────────────────────────── */
  .project-page {
    min-height: 100dvh;
  }

  /* ── Back nav ────────────────────────────────────────── */
  .back-bar {
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-3) 0;
  }

  .back-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }
  .back-link:hover { color: var(--color-text); }

  /* ── Project header ──────────────────────────────────── */
  .project-header {
    padding: var(--space-16) 0 var(--space-12);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    margin-bottom: var(--space-6);
  }

  .cat-badge {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid currentColor;
  }
  .cat-engineering { color: var(--color-cat-engineering); background: rgba(129, 140, 248, 0.07); }
  .cat-data        { color: var(--color-cat-data);        background: rgba(52, 211, 153, 0.07); }
  .cat-finance     { color: var(--color-cat-finance);     background: rgba(251, 191, 36, 0.07); }

  .meta-dot  { color: var(--color-text-faint); }
  .meta-type, .meta-inst { color: var(--color-text-muted); }
  .meta-date { color: var(--color-text-muted); font-size: 0.72rem; }

  .project-title {
    font-size: clamp(var(--text-2xl), 4.5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: var(--color-text);
    max-width: 22ch;
    margin-bottom: var(--space-6);
  }

  .project-summary {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    max-width: 65ch;
    line-height: 1.8;
    margin-bottom: var(--space-6);
  }

  .project-team {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .team-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .team-names {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  /* ── Metrics band ────────────────────────────────────── */
  .metrics-band {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .metrics-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--gutter);
    display: flex;
    flex-wrap: wrap;
    gap: 0;
  }

  .metric-item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-8) var(--space-4) 0;
    flex: 1;
    min-width: 140px;
  }

  .metric-divider {
    position: absolute;
    right: var(--space-4);
    top: var(--space-4);
    bottom: var(--space-4);
    width: 1px;
    background: var(--color-border);
  }

  .metric-value {
    font-size: clamp(var(--text-2xl), 3vw, var(--text-4xl));
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .metric-label {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    max-width: 16rem;
  }

  /* ── Cover image ─────────────────────────────────────── */
  .project-cover {
    position: relative;
    overflow: hidden;
    max-height: 420px;
    border-bottom: 1px solid var(--color-border);
  }

  .project-cover img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: brightness(0.8) saturate(0.85);
  }

  .cover-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, var(--color-bg) 100%);
  }

  /* ── Prose body ──────────────────────────────────────── */
  .project-body {
    padding: var(--space-16) 0 var(--space-24);
  }

  .project-body-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .project-prose {
    max-width: var(--content-width);
  }

  /* ── Figures ─────────────────────────────────────────── */
  .figures-section {
    margin-top: var(--space-16);
    padding-top: var(--space-12);
    border-top: 1px solid var(--color-border);
  }

  .figures-heading {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin-bottom: var(--space-8);
  }

  .figures-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .fig-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .fig-img-wrap {
    overflow: hidden;
    background: var(--color-surface-alt);
  }

  .fig-img-wrap img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.4s ease;
  }
  .fig-item:hover .fig-img-wrap img { transform: scale(1.02); }

  .fig-caption {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.6;
    border-top: 1px solid var(--color-border);
  }

  .fig-num {
    color: var(--color-accent);
    margin-right: var(--space-2);
    font-size: 0.68rem;
  }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 700px) {
    .figures-grid  { grid-template-columns: 1fr; }
    .metrics-inner { gap: var(--space-4); }
    .metric-item   { min-width: 120px; padding-right: var(--space-6); }
    .project-cover img { height: 220px; }
  }

  @media (max-width: 480px) {
    .metric-item   { flex: 0 0 100%; }
    .metric-divider { display: none; }
  }
</style>

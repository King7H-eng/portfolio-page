---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { PROJECT_ORDER } from '../lib/projects';

const base = import.meta.env.BASE_URL;

const ORDER = PROJECT_ORDER;

const allProjects = await getCollection('projects');
const projects = ORDER
  .map((slug) => allProjects.find((p) => p.data.slug === slug))
  .filter(Boolean);
---

<BaseLayout
  title="Nicholas Mommsen — Engineering & Finance"
  description="Portfolio of Nicholas Mommsen: BEng Mechanical Engineering (Durham), MSc Computational Methods (Imperial). Projects in battery thermal modelling, energy market research, autonomous drones and applied statistics."
>
  <SiteHeader />

  <main id="main-content">

    <!-- ── Hero ─────────────────────────────────────────── -->
    <section class="hero" aria-label="Introduction">
      <div class="hero-inner">

        <p class="hero-label mono">// Engineering · Data · Finance</p>

        <h1 class="hero-name">Nicholas<br/>Mommsen</h1>

        <!-- ✏️ Edit this positioning statement -->
        <p class="hero-tagline">
          Imperial College London | MSc Advanced Computational Aeronautics<br/>
          Durham University | BEng Mechanical Engineering
        </p>

        <div class="hero-actions">
          <a href={`${base}cv.pdf`} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
            Download CV
          </a>
          <a href="#projects" class="btn btn-secondary">
            View projects
          </a>
          <a href="https://www.linkedin.com/in/nicholas-mommsen" class="hero-text-link" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          <a href="https://github.com/King7H-eng" class="hero-text-link" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>

      </div>
    </section>

    <!-- ── About ─────────────────────────────────────────── -->
    <section class="about-section" id="about" aria-labelledby="about-heading">
      <div class="section-inner">
        <div class="section-label-row">
          <span class="section-label mono">// 01 — Background</span>
        </div>
        <h2 id="about-heading" class="section-heading">About</h2>

        <div class="about-grid">
          <div class="about-text">
            <p>
              I am a student born in Cape Town, South Africa, who moved to the UK five years ago to pursue higher
              education. I am currently completing my Master's in Advanced Computational Aeronautics, specialising
              mainly in the more "rocket science" aspects of the programme, such as orbital mechanics, spacecraft
              propulsion, and the aerothermodynamics of launchers and re-entry vehicles, alongside a minor
              specialisation in machine learning and applications of AI.
            </p>
            <p>
              During my undergraduate degree at Durham, I completed two internships in buy-side investment analyst
              roles alongside achieving a First Class result in Mechanical Engineering. I also took on roles in
              student finance societies, covering leadership positions, market commentary in the energy and
              commodities sector, and mock stock pitch competitions.
            </p>
          </div>

          <dl class="about-facts">
            <div class="about-fact">
              <dt class="mono">Now</dt>
              <dd>MSc Advanced Computational Methods for Aeronautics<span>Imperial College London</span></dd>
            </div>
            <div class="about-fact">
              <dt class="mono">Previously</dt>
              <dd>BEng Mechanical Engineering, First Class<span>Durham University</span></dd>
            </div>
            <div class="about-fact">
              <dt class="mono">Finance</dt>
              <dd>Two buy-side investment analyst internships<span>Energy &amp; commodities commentary</span></dd>
            </div>
            <div class="about-fact">
              <dt class="mono">From</dt>
              <dd>Cape Town, South Africa<span>Based in London</span></dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- ── Projects ──────────────────────────────────────── -->
    <section class="projects-section" id="projects" aria-labelledby="projects-heading">
      <div class="section-inner">

        <div class="section-label-row">
          <span class="section-label mono">// 02 — Selected projects</span>
        </div>
        <h2 id="projects-heading" class="section-heading">Projects</h2>

        <!-- Filter chips -->
        <div class="filters" role="group" aria-label="Filter projects by category">
          <button class="filter-btn mono active" data-filter="all">All</button>
          <button class="filter-btn mono" data-filter="engineering">Engineering</button>
          <button class="filter-btn mono" data-filter="data">Data</button>
          <button class="filter-btn mono" data-filter="energy">Energy</button>
        </div>

        <div class="projects-grid" id="projects-grid">
          {projects.map((project, i) => (
            project && (
              <ProjectCard
                title={project.data.title}
                slug={project.data.slug}
                summary={project.data.summary}
                metrics={project.data.metrics}
                tags={project.data.tags}
                category={project.data.category}
                extraCategories={project.data.extraCategories}
                type={project.data.type}
                cover={project.data.cover}
                coverPosition={project.data.coverPosition}
                index={i}
              />
            )
          ))}
        </div>

      </div>
    </section>

  </main>

  <!-- ── Footer ────────────────────────────────────────── -->
  <footer class="site-footer">
    <div class="footer-inner">
      <span class="mono footer-mark">NM_</span>
      <span class="footer-copy mono">Nicholas Mommsen · {new Date().getFullYear()}</span>
      <div class="footer-links">
        <a href="mailto:Nicholasmommsen@outlook.com" class="footer-link mono">Email</a>
        <a href="https://www.linkedin.com/in/nicholas-mommsen" class="footer-link mono" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://github.com/King7H-eng/portfolio-page" class="footer-link mono" target="_blank" rel="noopener noreferrer">Source</a>
      </div>
    </div>
  </footer>
</BaseLayout>

<!-- Filter logic -->
<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.project-card');

  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'all';
      btns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      cards.forEach((card) => {
        card.style.display = (filter === 'all' || (card.dataset.category ?? '').split(' ').includes(filter)) ? '' : 'none';
      });
    });
  });
</script>

<style>
  /* ── Hero ─────────────────────────────────────────────── */
  .hero {
    padding: clamp(6rem, 14vw, 8rem) var(--gutter) clamp(4rem, 10vw, 7rem);
  }

  .hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .hero-label {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-6);
  }

  .hero-name {
    font-size: clamp(2.75rem, 7vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.02;
    color: var(--text);
    margin-bottom: var(--space-6);
  }

  .hero-credentials {
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--text-faint);
    margin-bottom: var(--space-4);
  }

  .hero-tagline {
    font-size: clamp(var(--text-base), 2vw, 1.25rem);
    color: var(--text-muted);
    max-width: 620px;
    line-height: 1.65;
    margin-bottom: var(--space-8);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-6);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 600;
    transition: opacity var(--transition-fast), background var(--transition-fast), border-color var(--transition-fast);
    cursor: pointer;
  }

  .btn-primary {
    background: var(--accent);
    color: #000;
    border: 1px solid var(--accent);
  }
  .btn-primary:hover { opacity: 0.88; }

  .btn-secondary {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border-strong);
  }
  .btn-secondary:hover {
    border-color: rgba(255,255,255,0.25);
    background: rgba(255,255,255,0.04);
  }

  .hero-text-link {
    font-size: var(--text-sm);
    color: var(--text-muted);
    transition: color var(--transition-fast);
    padding: 0 var(--space-2);
  }
  .hero-text-link:hover { color: var(--text); }

  /* ── About section ────────────────────────────────────── */
  .about-section {
    padding: var(--space-12) 0;
  }
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: start;
  }
  .about-text p {
    color: var(--text-muted);
    line-height: 1.8;
    max-width: 62ch;
    margin: 0 0 var(--space-4);
    text-wrap: pretty;
  }
  .about-facts {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    backdrop-filter: blur(2px);
  }
  .about-fact {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5, 1.25rem);
  }
  .about-fact + .about-fact { border-top: 1px solid var(--border); }
  .about-fact dt {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    padding-top: 3px;
  }
  .about-fact dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text);
    line-height: 1.5;
  }
  .about-fact dd span {
    display: block;
    color: var(--text-faint);
    font-size: var(--text-xs);
    margin-top: 2px;
  }
  @media (max-width: 860px) {
    .about-grid { grid-template-columns: 1fr; gap: var(--space-8); }
  }

  /* ── Projects section ─────────────────────────────────── */
  .projects-section {
    padding: var(--space-12) 0 var(--space-24);
  }

  .section-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .section-label-row {
    margin-bottom: var(--space-3);
  }

  .section-label {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--accent);
    text-transform: uppercase;
  }

  .section-heading {
    font-size: clamp(var(--text-3xl), 4vw, var(--text-4xl));
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: var(--space-8);
  }

  /* Filter chips */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .filter-btn {
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    color: var(--text-faint);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 14px;
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
  }
  .filter-btn:hover {
    color: var(--text-muted);
    border-color: var(--border-strong);
  }
  .filter-btn.active {
    color: var(--accent);
    border-color: rgba(76, 141, 255, 0.5);
    background: rgba(76, 141, 255, 0.07);
  }

  /* Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 700px) {
    .projects-grid { grid-template-columns: 1fr; }
  }

  /* ── Footer ───────────────────────────────────────────── */
  .site-footer {
    border-top: 1px solid var(--border);
    padding: var(--space-8) var(--gutter);
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .footer-mark {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .footer-copy {
    font-size: var(--text-xs);
    color: var(--text-faint);
    flex: 1;
    letter-spacing: 0.03em;
  }

  .footer-links {
    display: flex;
    gap: var(--space-6);
  }

  .footer-link {
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--text-faint);
    transition: color var(--transition-fast);
  }
  .footer-link:hover { color: var(--text-muted); }
</style>

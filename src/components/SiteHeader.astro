---
const base = import.meta.env.BASE_URL;
---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <a href={base} class="wordmark mono" aria-label="Nicholas Mommsen — home">
      NM<span class="wordmark-underscore" aria-hidden="true">_</span>
    </a>

    <nav class="nav" aria-label="Site navigation">
      <a href="mailto:Nicholasmommsen@outlook.com" class="nav-link">Email</a>
      <a
        href="https://www.linkedin.com/in/nicholas-mommsen"
        class="nav-link"
        target="_blank"
        rel="noopener noreferrer"
      >LinkedIn</a>
      <a
        href="https://github.com/King7H-eng"
        class="nav-link"
        target="_blank"
        rel="noopener noreferrer"
      >GitHub</a>
      <a href={`${base}cv.pdf`} class="nav-cta mono" target="_blank" rel="noopener noreferrer">
        CV ↗
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 16);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid transparent;
    transition: background var(--transition-mid), border-color var(--transition-mid);
  }

  .site-header.scrolled {
    background: rgba(10, 10, 11, 0.70);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: rgba(255, 255, 255, 0.06);
  }

  .header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-4) var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .wordmark {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text);
    transition: opacity var(--transition-fast);
  }
  .wordmark:hover { opacity: 0.75; }

  .wordmark-underscore {
    color: var(--accent);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav-link {
    font-size: var(--text-sm);
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }
  .nav-link:hover { color: var(--text); }

  .nav-cta {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--accent);
    border: 1px solid rgba(76, 141, 255, 0.3);
    padding: 6px 14px;
    border-radius: var(--radius-md);
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }
  .nav-cta:hover {
    background: rgba(76, 141, 255, 0.08);
    border-color: rgba(76, 141, 255, 0.5);
  }

  @media (max-width: 480px) {
    .nav-link { display: none; }
  }
</style>

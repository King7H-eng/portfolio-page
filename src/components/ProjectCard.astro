---
export interface Props {
  title: string;
  slug: string;
  summary: string;
  metrics: { value: string; label: string; source: string }[];
  tags: string[];
  category: string;
  type: string;
  cover: string;
  index: number;
}

const { title, slug, summary, metrics, tags, category, type, cover, index } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}projects/${slug}`;
---

<article
  class="project-card"
  style={`--card-index: ${index}`}
  aria-label={title}
>
  <a href={href} class="card-link" tabindex="-1" aria-hidden="true"></a>

  <div class="card-cover" aria-hidden="true">
    {cover ? (
      <img src={cover} alt="" loading="lazy" decoding="async" />
    ) : (
      <div class="cover-placeholder"></div>
    )}
    <div class="cover-overlay"></div>
  </div>

  <div class="card-body">
    <div class="card-meta">
      <span class="meta-category mono">{category}</span>
      <span class="meta-sep" aria-hidden="true">·</span>
      <span class="meta-type">{type}</span>
    </div>

    <h2 class="card-title">
      <a href={href}>{title}</a>
    </h2>

    <p class="card-summary">{summary}</p>

    <div class="card-metrics" aria-label="Key metrics">
      {metrics.slice(0, 3).map((m) => (
        <div class="metric">
          <span class="metric-value mono" data-target={m.value}>{m.value}</span>
          <span class="metric-label">{m.label}</span>
        </div>
      ))}
    </div>

    <div class="card-tags" aria-label="Tags">
      {tags.slice(0, 4).map((tag) => (
        <span class="tag mono">{tag}</span>
      ))}
    </div>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      border-color var(--transition-mid),
      transform var(--transition-mid);
    animation: card-enter 0.5s ease both;
    animation-delay: calc(var(--card-index) * 80ms);
  }

  @keyframes card-enter {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .project-card:hover {
    border-color: var(--color-border-mid);
    transform: translateY(-2px);
  }

  .project-card:has(.card-link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* Invisible full-card click target */
  .card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  /* Make the title link sit above the card-link */
  .card-title a {
    position: relative;
    z-index: 2;
  }

  /* ---- Cover image ---- */
  .card-cover {
    position: relative;
    aspect-ratio: 16 / 7;
    overflow: hidden;
    background: var(--color-surface-alt);
  }

  .card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.4s ease;
  }

  .project-card:hover .card-cover img {
    transform: scale(1.03);
  }

  .cover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 40%,
      rgba(10, 13, 18, 0.7) 100%
    );
  }

  .cover-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      var(--color-surface-alt) 0%,
      var(--color-accent-bg) 100%
    );
  }

  /* ---- Card body ---- */
  .card-body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
  }

  .meta-category {
    color: var(--color-accent);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.7rem;
    font-weight: 500;
  }

  .meta-sep {
    color: var(--color-text-faint);
  }

  .meta-type {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .card-title {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .card-title a {
    color: var(--color-text);
    transition: color var(--transition-fast);
  }
  .card-title a:hover { color: var(--color-accent); }

  .card-summary {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ---- Metrics ---- */
  .card-metrics {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    flex-wrap: wrap;
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .metric-value {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .metric-label {
    font-size: 0.65rem;
    color: var(--color-text-muted);
    letter-spacing: 0.03em;
    line-height: 1.3;
    max-width: 9rem;
  }

  /* ---- Tags ---- */
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: auto;
  }

  .tag {
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 2px 8px;
  }
</style>

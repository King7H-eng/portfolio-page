---
export interface Props {
  title: string;
  slug: string;
  summary: string;
  metrics: { value: string; label: string; source: string }[];
  tags: string[];
  category: string;
  type: string;
  cover: string;
  index: number;
}

const { title, slug, summary, metrics, tags, category, type, cover, index } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}projects/${slug}`;

// Normalise category for CSS class and filter matching
const catKey = category.toLowerCase().replace(/[^a-z]/g, '');
---

<article
  class="project-card"
  style={`--card-index: ${index}`}
  data-category={catKey}
  aria-label={title}
>
  <!-- Invisible full-card click target -->
  <a href={href} class="card-link" tabindex="-1" aria-hidden="true"></a>

  <!-- Cover image -->
  {cover && (
    <div class="card-cover" aria-hidden="true">
      <img src={cover} alt="" loading="lazy" decoding="async" />
      <div class="cover-gradient"></div>
    </div>
  )}

  <div class="card-body">
    <!-- Category + type -->
    <div class="card-meta">
      <span class={`cat-tag mono cat-${catKey}`}>{category}</span>
      <span class="meta-type">{type}</span>
    </div>

    <!-- Title -->
    <h2 class="card-title">
      <a href={href}>{title}</a>
    </h2>

    <!-- Summary -->
    <p class="card-summary">{summary}</p>

    <!-- Metrics -->
    {metrics.length > 0 && (
      <div class="card-metrics" aria-label="Key metrics">
        {metrics.slice(0, 3).map((m) => (
          <div class="metric">
            <span class="metric-value mono">{m.value}</span>
            <span class="metric-label">{m.label}</span>
          </div>
        ))}
      </div>
    )}

    <!-- Tags -->
    <div class="card-tags" aria-label="Skills and tools">
      {tags.slice(0, 5).map((tag) => (
        <span class="tag mono">{tag}</span>
      ))}
    </div>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      border-color var(--transition-mid),
      transform var(--transition-mid),
      box-shadow var(--transition-mid);
    animation: card-enter 0.45s ease both;
    animation-delay: calc(var(--card-index) * 80ms);
  }

  @keyframes card-enter {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .project-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(56, 189, 248, 0.08);
  }

  .project-card:has(.card-link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* Invisible full-card click target */
  .card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  /* Title link sits above card-link */
  .card-title a {
    position: relative;
    z-index: 2;
  }

  /* ---- Cover ---- */
  .card-cover {
    position: relative;
    aspect-ratio: 16 / 7;
    overflow: hidden;
    background: var(--color-surface-alt);
  }

  .card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.4s ease;
    filter: brightness(0.85) saturate(0.9);
  }

  .project-card:hover .card-cover img {
    transform: scale(1.03);
  }

  .cover-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 50%, var(--color-surface) 100%);
  }

  /* ---- Body ---- */
  .card-body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    flex: 1;
  }

  /* ---- Meta ---- */
  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .cat-tag {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid currentColor;
    opacity: 0.9;
  }

  .cat-engineering { color: var(--color-cat-engineering); background: rgba(129, 140, 248, 0.07); }
  .cat-data        { color: var(--color-cat-data);        background: rgba(52, 211, 153, 0.07); }
  .cat-finance     { color: var(--color-cat-finance);     background: rgba(251, 191, 36, 0.07); }

  /* fallback */
  .cat-tag:not([class*="cat-engineering"]):not([class*="cat-data"]):not([class*="cat-finance"]) {
    color: var(--color-text-muted);
    background: var(--color-surface-alt);
    border-color: var(--color-border);
  }

  .meta-type {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  /* ---- Title ---- */
  .card-title {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .card-title a {
    color: var(--color-text);
    transition: color var(--transition-fast);
  }
  .card-title a:hover { color: var(--color-accent); }

  /* ---- Summary ---- */
  .card-summary {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ---- Metrics ---- */
  .card-metrics {
    display: flex;
    gap: var(--space-6);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    flex-wrap: wrap;
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .metric-value {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .metric-label {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    line-height: 1.3;
    max-width: 10rem;
  }

  /* ---- Tags ---- */
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: auto;
  }

  .tag {
    font-size: 0.68rem;
    letter-spacing: 0.03em;
    color: var(--color-text-faint);
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 3px 8px;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .project-card:hover .tag {
    color: var(--color-text-muted);
    border-color: var(--color-border-mid);
  }
</style>

---
export interface Props {
  title: string;
  slug: string;
  summary: string;
  metrics: { value: string; label: string; source: string }[];
  tags: string[];
  category: string;
  type: string;
  cover: string;
  index: number;
}

const { title, slug, summary, metrics, tags, category, type, cover, index } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}projects/${slug}`;

const catKey = category.toLowerCase().replace(/[^a-z]/g, '');
---

<article
  class="project-card"
  style={`--card-index: ${index}`}
  data-category={catKey}
  aria-label={title}
>
  <!-- Invisible full-card click target -->
  <a href={href} class="card-link" tabindex="-1" aria-hidden="true"></a>

  <!-- Cover -->
  {cover && (
    <div class="card-cover" aria-hidden="true">
      <img src={cover} alt="" loading="lazy" decoding="async" />
      <div class="cover-fade"></div>
    </div>
  )}

  <div class="card-body">

    <!-- Category + type -->
    <div class="card-meta">
      <span class={`cat-tag mono cat-${catKey}`}>{category}</span>
      <span class="meta-type">{type}</span>
    </div>

    <!-- Title -->
    <h2 class="card-title">
      <a href={href}>{title}</a>
    </h2>

    <!-- Summary -->
    <p class="card-summary">{summary}</p>

    <!-- Metrics -->
    {metrics.length > 0 && (
      <div class="card-metrics" aria-label="Key metrics">
        {metrics.slice(0, 3).map((m) => (
          <div class="metric">
            <span class="metric-value mono">{m.value}</span>
            <span class="metric-label">{m.label}</span>
          </div>
        ))}
      </div>
    )}

    <!-- Tags / skills -->
    {tags.length > 0 && (
      <div class="card-tags mono" aria-label="Skills and tools">
        {tags.slice(0, 5).map((tag, i) => (
          <span class="tag">{tag}{i < Math.min(tags.length, 5) - 1 ? ' ·' : ''}</span>
        ))}
      </div>
    )}

    <!-- Read more -->
    <a href={href} class="card-cta mono" aria-hidden="true" tabindex="-1">
      Read more →
    </a>

  </div>
</article>

<style>
  .project-card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 0;
    transition:
      border-color var(--transition-mid),
      transform var(--transition-mid),
      box-shadow var(--transition-mid);
    animation: card-enter 0.45s ease both;
    animation-delay: calc(var(--card-index) * 80ms);
    /* Slightly translucent so background glows show through */
    backdrop-filter: blur(2px);
  }

  @keyframes card-enter {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card { animation: none; }
  }

  .project-card:hover {
    border-color: rgba(76, 141, 255, 0.45);
    transform: translateY(-2px);
    box-shadow:
      0 0 0 1px rgba(76, 141, 255, 0.10),
      0 12px 40px -12px rgba(76, 141, 255, 0.25);
  }

  .project-card:has(.card-link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Full-card invisible click target */
  .card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  /* Title link sits above card-link */
  .card-title a,
  .card-cta {
    position: relative;
    z-index: 2;
  }

  /* ── Cover ────────────────────────────────── */
  .card-cover {
    position: relative;
    aspect-ratio: 16 / 7;
    overflow: hidden;
    background: rgba(17, 17, 20, 0.9);
  }

  .card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.4s ease;
    filter: brightness(0.8) saturate(0.85);
  }

  .project-card:hover .card-cover img { transform: scale(1.03); }

  .cover-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 50%, var(--bg) 100%);
  }

  /* ── Body ─────────────────────────────────── */
  .card-body {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    flex: 1;
  }

  /* ── Meta ─────────────────────────────────── */
  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .cat-tag {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-style: solid;
  }

  .cat-engineering {
    color: var(--cat-engineering);
    border-color: rgba(127, 176, 255, 0.30);
    background: transparent;
  }
  .cat-data {
    color: var(--cat-data);
    border-color: rgba(196, 168, 255, 0.30);
    background: transparent;
  }
  .cat-finance {
    color: var(--cat-finance);
    border-color: rgba(94, 230, 176, 0.30);
    background: transparent;
  }
  /* Fallback */
  .cat-tag:not([class*="cat-engineering"]):not([class*="cat-data"]):not([class*="cat-finance"]) {
    color: var(--text-muted);
    border-color: var(--border);
  }

  .meta-type {
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  /* ── Title ────────────────────────────────── */
  .card-title {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .card-title a {
    color: var(--text);
    transition: color var(--transition-fast);
  }
  .card-title a:hover { color: var(--accent); }

  /* ── Summary ──────────────────────────────── */
  .card-summary {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Metrics ──────────────────────────────── */
  .card-metrics {
    display: flex;
    gap: var(--space-6);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .metric-value {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .metric-label {
    font-size: 0.68rem;
    color: var(--text-muted);
    line-height: 1.3;
    max-width: 10rem;
  }

  /* ── Tags / skills ────────────────────────── */
  .card-tags {
    font-size: var(--text-xs);
    color: var(--text-faint);
    letter-spacing: 0.03em;
    line-height: 1.6;
  }

  /* ── Read more ────────────────────────────── */
  .card-cta {
    display: inline-block;
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--accent);
    margin-top: auto;
    transition: opacity var(--transition-fast);
    opacity: 0;
  }

  .project-card:hover .card-cta { opacity: 1; }
</style>

---
/**
 * What went wrong on the eVTOL and why, taken only from the report's
 * Flight Testing, Crash Analysis and Critical Review sections.
 * "Action taken" = done during the project; "Recommended" = proposed in the report, not built.
 */
const cases = [
  {
    title: 'First flight: tipped over on take-off',
    happened: 'The drone could not take off from the ground without flipping over.',
    cause: 'Footage showed the thin metal wire feet getting stuck in the grassy, mossy ground, so the drone pivoted around them.',
    response: 'The next flight took off from a metal plate. The report also recommends more rigid landing legs.',
    status: 'Action taken',
  },
  {
    title: 'Second flight: flipped on throttle-up',
    happened: 'As the throttle increased, the drone flipped backwards and to the side, damaging the wings beyond repair.',
    cause: 'Not confirmed. The logs did not capture the desired pitch, so a levelling error could not be ruled out, and the larger supplied battery concentrated the mass, leaving the elevons little authority to correct imbalances.',
    response: 'Use a smaller battery and the combined flight controller and power board that the airframe was designed for.',
    status: 'Recommended',
  },
  {
    title: 'Structure: weak wing joints',
    happened: 'Parts broke easily, and a single break meant reprinting a whole wing.',
    cause: 'The wing sections were glued with minimal overlap and no spar, and the parts were printed with a single wall loop.',
    response: 'Add spars or a carbon rod through the wing–fuselage joint, move to a modular airframe, and use stronger materials such as carbon-fibre composites.',
    status: 'Recommended',
  },
  {
    title: 'Sensors: calibration and interference',
    happened: 'Testing hit GPS calibration errors, electromagnetic interference and accelerometer calibration problems.',
    cause: 'High-current wires ran very close to the flight controller and GPS in the cramped fuselage, and the separate flight controller was hard to mount level.',
    response: 'A combined flight controller and power board, and a smaller battery, would free space to separate the high-current wires and mount the controller level.',
    status: 'Recommended',
  },
];
---

<div class="fa-grid not-prose">
  {cases.map((c, i) => (
    <article class="fa-card">
      <header class="fa-head">
        <span class="fa-num mono">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="fa-title">{c.title}</h3>
      </header>
      <dl class="fa-rows">
        <div class="fa-row"><dt class="mono">What happened</dt><dd>{c.happened}</dd></div>
        <div class="fa-row"><dt class="mono">Cause</dt><dd>{c.cause}</dd></div>
        <div class="fa-row">
          <dt class="mono">Response <span class:list={['fa-status', { 'is-done': c.status === 'Action taken' }]}>{c.status}</span></dt>
          <dd>{c.response}</dd>
        </div>
      </dl>
    </article>
  ))}
</div>

<style>
  .fa-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin: var(--space-6) 0 var(--space-8);
  }
  .fa-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    padding: var(--space-5, 1.25rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .fa-head { display: flex; align-items: baseline; gap: var(--space-3); }
  .fa-num { font-size: 0.72rem; color: var(--accent); letter-spacing: 0.08em; }
  .fa-title { margin: 0; font-size: var(--text-base); font-weight: 600; color: var(--text); line-height: 1.35; }
  .fa-rows { margin: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .fa-row dt {
    font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-faint);
    margin-bottom: 4px; display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap;
  }
  .fa-row dd { margin: 0; font-size: var(--text-sm); color: var(--text-muted); line-height: 1.6; }
  .fa-status {
    text-transform: none; letter-spacing: 0.02em; font-size: 0.66rem;
    padding: 1px 7px; border-radius: 999px;
    border: 1px dashed var(--border-strong); color: var(--text-muted);
  }
  .fa-status.is-done {
    border-style: solid; color: var(--cat-finance, #5EE6B0);
    border-color: color-mix(in srgb, var(--cat-finance, #5EE6B0) 40%, transparent);
  }
  @media (max-width: 760px) { .fa-grid { grid-template-columns: 1fr; } }
</style>

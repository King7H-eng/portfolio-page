---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/global.css';
import Background from '../components/Background.astro';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  showBackground?: boolean;
}

const { title, description, ogImage, ogType = 'website', showBackground = true } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://king7h-eng.github.io');

const SITE = 'https://king7h-eng.github.io';
const defaultOg = `${SITE}/portfolio-page/figures/battery-cooling/fig-coated-vs-uncoated.png`;
const ogImageURL = ogImage
  ? (ogImage.startsWith('http') ? ogImage : `${SITE}${ogImage}`)
  : defaultOg;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="dark" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:site_name" content="Nicholas Mommsen" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>

  <!-- Page wrapper — position relative so absolute bg layers are contained -->
  <div class="page-wrapper">
    {showBackground && <Background />}
    <div class="page-content">
      <slot />
    </div>
  </div>
</body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: var(--space-2);
    z-index: 999;
    background: var(--accent);
    color: #000;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: var(--text-sm);
  }
  .skip-link:focus { left: var(--space-4); }

  .page-wrapper {
    position: relative;
    min-height: 100dvh;
    overflow-x: hidden;
  }

  .page-content {
    position: relative;
    z-index: 1;
  }
</style>
